# Local-only prototype. Do not copy tokens into source control.
CONTROL_PLANE_API_KEY=replace-with-a-long-random-local-secret
ENABLE_LIVE_EXECUTION=false
ENABLE_LOCAL_ROUTING=true
ENABLE_AZURE_ROUTING=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# These are illustrative assumptions, NOT actual pricing or bills.
LOCAL_ESTIMATED_USD_PER_REQUEST=0.005
AZURE_ESTIMATED_USD_PER_REQUEST=0.03
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
