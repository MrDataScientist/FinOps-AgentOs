{
  "title": "FinOps-AgentOS — Prototype Observability",
  "uid": "finops-agentos-local",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed inference rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agentos_requests_total{status=\"completed\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Illustrative cost (NOT billed)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(agentos_illustrative_cost_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Reported token consumption",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (direction) (agentos_tokens_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Inference p95 duration",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentos_inference_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}
